# ---------------------------------------------------------------------------
# Ringfence — environment template
#
# Copy this file to `.env.local` and fill in the values from your CognoDB
# instance. `.env.local` is gitignored and must never be committed.
#
#   cp .env.example .env.local
#
# Create a free instance at https://console.cognodb.com/signup
#   1. Sign up (free tier, no credit card).
#   2. Create a free `c0` instance and pick the region nearest you.
#   3. Copy the generated password IMMEDIATELY — it is shown exactly once.
#   4. The connection URI is on the instance detail page.
# ---------------------------------------------------------------------------

# Bolt-over-TLS URI from the CognoDB console.
# Format: bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud

# CognoDB provisions a single user named `cognodb`.
COGNODB_USER=cognodb

# The password shown once at instance creation. Leave blank here — it goes
# in .env.local only.
COGNODB_PASSWORD=
